NODE_ENV=production
PORT=8000
APP_NAME=Loom
# Public URL of THIS API (used by the keep-alive ping)
API_URL=https://api.your-domain.com
# Comma-separated list of allowed web/app origins (no trailing slash). The deployed web portal MUST be here.
CLIENT_URL=https://seller.your-domain.com
# Reverse-proxy hops in front of the API (Render/Railway/nginx = 1)
TRUST_PROXY=1
# Only set when the web and API share a parent domain, e.g. .your-domain.com
COOKIE_DOMAIN=

DATABASE_URL=
JWT_SECRET=            # >= 32 chars, different from the refresh secret
JWT_REFRESH_SECRET=    # >= 32 chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Loom

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# M-Pesa — must be 'production' with live credentials for real payments
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.your-domain.com/api/v1/payments/mpesa/callback
# Leave empty to use Safaricom's published IPs when MPESA_ENVIRONMENT=production
MPESA_CALLBACK_IPS=

AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
API_RATE_LIMIT_MAX_ATTEMPTS=300
