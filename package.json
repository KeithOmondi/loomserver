  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --max-old-space-size=4096 --expose-gc dist/server.js",
    "migrate": "tsx src/config/migrate.ts",
    "seed": "tsx src/config/seed.ts",
    "test": "vitest run",
    "dev": "tsx watch --max-old-space-size=4096 src/server.ts",
    "dev:debug": "nodemon --watch src --ext ts --exec \"node --max-old-space-size=4096 --expose-gc --inspect -r @swc-node/register src/server.ts\""
  },
  "keywords": [],
